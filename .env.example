# Copy this file to .env (which is gitignored) and fill in your Razorpay TEST-mode credentials
# from the Razorpay Dashboard: Settings > API Keys. docker-compose.yml reads these into
# payment-service; see README "Payments" for the full setup walkthrough.
#
# KeyId/KeySecret are required for Payment Service to create/verify payments at all.
# WebhookSecret is only needed if you also wire up the /api/payments/webhook endpoint (requires
# a public URL, e.g. via a tunnel — see README).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Signs/validates every JWT issued by Identity Service — shared by every service that calls
# AddJwtAuthentication (see BuildingBlocks/Auth). Must be at least 32 bytes/256 bits for HS256;
# generate one with `openssl rand -base64 48` or similar. Rotating it invalidates every
# outstanding access/refresh token.
JWT_SIGNING_KEY=

# Bootstraps one Admin account on Identity Service's first startup (idempotent — leave blank on
# later runs, or change to rotate the seeded password; it only ever creates, never updates).
ADMIN_SEED_EMAIL=admin@ecommerce.local
ADMIN_SEED_PASSWORD=
