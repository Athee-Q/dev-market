{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "RateLimiting": {
    "GlobalPermitLimit": 200,
    "GlobalWindowSeconds": 60,
    "WritesPermitLimit": 20,
    "WritesWindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/identity/{**catch-all}" }
      },
      "products-route": {
        "ClusterId": "product-cluster",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "customers-route": {
        "ClusterId": "customer-cluster",
        "Match": { "Path": "/api/customers/{**catch-all}" }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "RateLimiterPolicy": "writes",
        "Match": { "Path": "/api/cart/{**catch-all}" }
      },
      "orders-route": {
        "ClusterId": "order-cluster",
        "RateLimiterPolicy": "writes",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "payments-route": {
        "ClusterId": "payment-cluster",
        "RateLimiterPolicy": "writes",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "notifications-hub-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/hubs/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5008" } }
      },
      "product-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5001" } }
      },
      "customer-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5002" } }
      },
      "cart-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5003" } }
      },
      "order-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5004" } }
      },
      "payment-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5007" } }
      },
      "notification-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5006" } }
      }
    }
  }
}
